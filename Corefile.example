.:1053 {
    errors
    log
    coolify https://coolify.example.com {
        token_env COOLIFY_API_TOKEN
        server server-uuid-one
        server server-uuid-two 192.0.2.20
        server server-uuid-three edge.example.net
        refresh 1m
        timeout 10s
        ttl 60
    }
    forward . 1.1.1.1 9.9.9.9
}
